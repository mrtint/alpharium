{
  "name": "alpharium",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "expo": "~57.0.14",
    "expo-background-task": "~57.0.14",
    "expo-file-system": "~57.0.4",
    "expo-image-manipulator": "~57.0.12",
    "expo-intent-launcher": "~57.0.1",
    "expo-location": "~57.0.12",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "llama.rn": "^0.12.8",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest --maxWorkers=50%",
    "test:logic": "jest --selectProjects logic --maxWorkers=50%",
    "test:ui": "jest --selectProjects ui --maxWorkers=50%",
    "test:device": "node scripts/run-device-tests.mjs",
    "lint": "eslint . && tsc --noEmit && npm run check:constitution && npm run format:check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"*.{ts,tsx}\"",
    "check:constitution": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-constitution.mts",
    "seed:day": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-day.mts",
    "seed:list": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-list.mts",
    "seed:clear": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-clear.mts"
  },
  "jest": {
    "projects": [
      {
        "displayName": "logic",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": [
            "babel-jest",
            {
              "presets": [
                "babel-preset-expo"
              ]
            }
          ]
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(expo|expo-modules-core|@expo)/)"
        ]
      },
      {
        "displayName": "ui",
        "preset": "jest-expo",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.tsx",
          "<rootDir>/__tests__/jest-projects.test.ts"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/jest/setup-ui.ts"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "private": true
}
