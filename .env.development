# local 환경 — 개발자 기계의 시뮬레이터
#
# 시뮬레이터에는 네이티브 추론 모듈이 없으므로 데스크톱 추론 서버를 쓴다.
# 헌법 원칙 I이 개발·튜닝 단계에 허용한 경로이며, 온디바이스와 동일한
# GGUF·프롬프트·샘플링 파라미터를 쓴다는 제약을 받는다(FR-013).
#
# 서버 주소 키는 local에만 존재한다(FR-014). dev·prod에는 키 자체를 두지 않는다.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_DESKTOP_INFERENCE_URL=http://localhost:8080/v1
