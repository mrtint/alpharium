+/// Pocketlog 091 (patches/): BGTasks launched while one is running. The first runs the JS work; the rest
+/// wait and are completed together with it. Guarded by a lock — handlers run on BGTaskScheduler's queue.
+final class BackgroundTaskGroup {
+  static let shared = BackgroundTaskGroup()
+  private let lock = NSLock()
+  private var tasks: [BGTask] = []
+
+  /// Adds the task. Returns true when it is the first of a new group (it should run the work).
+  func join(_ task: BGTask) -> Bool {
+    lock.lock(); defer { lock.unlock() }
+    tasks.append(task)
+    return tasks.count == 1
+  }
+
+  func leave(_ task: BGTask) {
+    lock.lock(); defer { lock.unlock() }
+    tasks.removeAll { $0 === task }
+  }
+
+  func finishAll(success: Bool) {
+    lock.lock()
+    let finishing = tasks
+    tasks.removeAll()
+    lock.unlock()
+    for task in finishing { task.setTaskCompleted(success: success) }
+  }
+}
