{
  "expo": {
    "name": "Pocketlog",
    "slug": "pocketlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "appleTeamId": "PGNGG84B39",
      "bundleIdentifier": "com.a810labs.pocketlog",
      "buildNumber": "19",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "앱은 움직임 정보를 쓰지 않습니다."
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fffdf8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 19,
      "predictiveBackGestureEnabled": false,
      "package": "com.a810labs.pocketlog",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ko": {
        "android": {
          "app_name": "포켓로그"
        },
        "ios": {
          "CFBundleDisplayName": "포켓로그"
        }
      }
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableEntitlements": false
        }
      ],
      [
        "./plugins/with-release-signing",
        {
          "keystorePath": "pocketlog.jks",
          "keyAlias": "pocketlog"
        }
      ],
      "./plugins/with-battery-exception",
      "./plugins/with-force-light-theme",
      "./plugins/with-nav-bar-contrast",
      "./plugins/with-backup-rules",
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"],
          "isAccessMediaLocationEnabled": true,
          "photosPermission": "그날 찍힌 사진을 읽어 하루를 일기로 씁니다. 사진은 휴대폰 밖으로 나가지 않습니다.",
          "savePhotosPermission": false
        }
      ],
      "expo-background-task",
      "./plugins/with-battery-bg-task",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Regular.otf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-SemiBold.otf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Bold.otf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-ExtraBold.otf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/pretendard/Pretendard-Regular.otf",
              "./assets/fonts/pretendard/Pretendard-Medium.otf",
              "./assets/fonts/pretendard/Pretendard-SemiBold.otf",
              "./assets/fonts/pretendard/Pretendard-Bold.otf",
              "./assets/fonts/pretendard/Pretendard-ExtraBold.otf"
            ]
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/with-no-push-entitlement"
    ]
  }
}
