{
  "expo": {
    "name": "Pocketlog",
    "slug": "pocketlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "PGNGG84B39",
      "bundleIdentifier": "com.a810labs.pocketlog",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 9,
      "predictiveBackGestureEnabled": false,
      "package": "com.a810labs.pocketlog",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ko": {
        "android": {
          "app_name": "포켓로그"
        },
        "ios": {
          "CFBundleDisplayName": "포켓로그"
        }
      }
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableEntitlements": false
        }
      ],
      [
        "./plugins/with-release-signing",
        {
          "keystorePath": "pocketlog.jks",
          "keyAlias": "pocketlog"
        }
      ],
      "./plugins/with-battery-exception",
      "./plugins/with-force-light-theme",
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"],
          "isAccessMediaLocationEnabled": true,
          "photosPermission": "그날 찍힌 사진을 읽어 하루를 일기로 씁니다. 사진은 휴대폰 밖으로 나가지 않습니다.",
          "savePhotosPermission": false
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "사진에 담긴 장소를 사람이 읽을 수 있는 이름으로 바꾸는 데 위치를 씁니다.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "앱은 움직임 정보를 쓰지 않습니다. 위치 기능이 포함한 라이브러리 때문에 표시되는 항목입니다."
        }
      ],
      "./plugins/with-no-push-entitlement"
    ]
  }
}
