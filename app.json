{
  "expo": {
    "name": "alpharium",
    "slug": "alpharium",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "S6B8RQH6YQ",
      "bundleIdentifier": "com.anonymous.alpharium"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 9,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.alpharium",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "llama.rn",
        {
          "enableEntitlements": false
        }
      ],
      [
        "./plugins/with-release-signing",
        {
          "keystorePath": "alpharium.jks",
          "keyAlias": "alpharium"
        }
      ],
      "./plugins/with-battery-exception",
      "./plugins/with-force-light-theme",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "사진에 담긴 장소를 사람이 읽을 수 있는 이름으로 바꾸는 데 위치를 씁니다."
        }
      ]
    ]
  }
}
